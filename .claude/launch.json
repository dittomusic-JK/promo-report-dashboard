{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "promo-report",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 3000
    },
    {
      "name": "prototypes",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const D=p.join(process.cwd(),'prototypes');h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';f.readFile(p.join(D,u),(e,b)=>{if(e){r.writeHead(404);return r.end('not found');}r.writeHead(200,{'Content-Type':u.endsWith('.html')?'text/html; charset=utf-8':'application/octet-stream','Cache-Control':'no-store'});r.end(b);});}).listen(8765);"],
      "port": 8765
    }
  ]
}
